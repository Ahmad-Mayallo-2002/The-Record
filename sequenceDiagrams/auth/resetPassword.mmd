sequenceDiagram
actor User
participant Client
participant "Auth Controller" as Controller
participant "Auth Service" as Service
participant "OTP Service" as OTP
participant "User Repository" as Repo
participant "Password Service" as Password
database DB

User ->> Client: Enter email, OTP, newPassword, confirmPassword
Client ->> Controller: POST /auth/reset-password

Controller ->> Service: resetPassword(dto)

Service ->> Repo: findByEmail(email)
Repo ->> DB: SELECT user WHERE email = ?
DB -->> Repo: User / null
Repo -->> Service: User / null

alt User not found
    Service -->> Controller: NotFoundException (404)
    Controller -->> Client: 404 User not found
else User found
    Service ->> OTP: Verify OTP(userId, code)
    OTP ->> DB: Check OTP
    DB -->> OTP: Valid / Invalid / Expired
    OTP -->> Service: Result

    alt OTP is invalid or expired
        Service -->> Controller: BadRequestException (400)
        Controller -->> Client: 400 Invalid or expired OTP
    else OTP is valid
        Service ->> Password: Hash new password
        Password -->> Service: hashedPassword

        Service ->> Repo: Update password
        Repo ->> DB: UPDATE user.password
        DB -->> Repo: Updated
        Repo -->> Service: Success

        Service ->> OTP: Delete/Invalidate OTP
        OTP ->> DB: DELETE OTP
        DB -->> OTP: Deleted

        Service -->> Controller: Password reset successfully
        Controller -->> Client: 200 OK
    end
end