sequenceDiagram
actor User
participant Client
participant "Auth Controller" as Controller
participant "Auth Service" as Service
participant "User Repository" as Repo
participant "Password Service" as Password
participant "JWT Service" as JWT
database DB

User ->> Client: Enter email and password
Client ->> Controller: POST /auth/login

Controller ->> Service: login(dto)

Service ->> Repo: findByEmail(email)
Repo ->> DB: SELECT user WHERE email = ?
DB -->> Repo: User / null
Repo -->> Service: User / null

alt User not found
    Service -->> Controller: UnauthorizedException (401)
    Controller -->> Client: 401 Invalid email or password
else User found
    Service ->> Password: Compare(password, hashedPassword)
    Password -->> Service: Match / No Match

    alt Password is incorrect
        Service -->> Controller: UnauthorizedException (401)
        Controller -->> Client: 401 Invalid email or password
    else Password is correct
        Service ->> JWT: Generate Access Token
        JWT -->> Service: accessToken

        Service ->> JWT: Generate Refresh Token
        JWT -->> Service: refreshToken

        Service -->> Controller: User + Tokens
        Controller -->> Client: 200 OK (accessToken, refreshToken)
    end
end