sequenceDiagram
actor User
participant Client
participant "Comment Controller" as Controller
participant "Comment Service" as Service
participant "Post Repository" as PostRepo
participant "Comment Repository" as CommentRepo
database DB

User ->> Client: View post comments
Client ->> Controller: GET /posts/:postId/comments

Controller ->> Service: getPostComments(postId)

Service ->> PostRepo: findById(postId)
PostRepo ->> DB: SELECT post
DB -->> PostRepo: Post / null
PostRepo -->> Service: Post / null

alt Post not found
    Service -->> Controller: NotFoundException (404)
    Controller -->> Client: 404 Post not found
else Post found
    Service ->> CommentRepo: findByPost(postId)
    CommentRepo ->> DB: SELECT comments
    DB -->> CommentRepo: Comments
    CommentRepo -->> Service: Comments

    Service -->> Controller: Comments
    Controller -->> Client: 200 OK
end