sequenceDiagram
actor User
participant Client
participant "Reaction Controller" as Controller
participant "Reaction Service" as Service
participant "Reaction Repository" as Repo
database DB

User ->> Client: Like post
Client ->> Controller: POST /posts/:postId/like

Controller ->> Service: addLike(postId, currentUser)

Service ->> Repo: findUserReaction(postId, userId)
Repo ->> DB: SELECT reaction
DB -->> Repo: Reaction / null
Repo -->> Service: Reaction / null

alt Existing Like
    Service ->> Repo: deleteReaction()
    Repo ->> DB: DELETE like
    DB -->> Repo: Deleted
    Repo -->> Service: Success

    Service -->> Controller: Like removed
    Controller -->> Client: 200 OK
else Existing Dislike
    Service ->> Repo: deleteReaction()
    Repo ->> DB: DELETE dislike
    DB -->> Repo: Deleted

    Service ->> Repo: createLike()
    Repo ->> DB: INSERT like
    DB -->> Repo: Created

    Service -->> Controller: Like added
    Controller -->> Client: 201 Created
else No Reaction
    Service ->> Repo: createLike()
    Repo ->> DB: INSERT like
    DB -->> Repo: Created

    Service -->> Controller: Like added
    Controller -->> Client: 201 Created
end